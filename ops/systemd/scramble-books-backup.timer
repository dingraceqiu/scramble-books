# Scramble Books 云端库备份定时器：每天 04:30（服务器本地时间，Asia/Shanghai）一次。
#
# 查看：
#   systemctl list-timers scramble-books-backup.timer --no-pager
#   systemctl status scramble-books-backup.timer
# 手动触发一次备份：sudo systemctl start scramble-books-backup.service

[Unit]
Description=Daily timer for Scramble Books cloud DB backup

[Timer]
OnCalendar=*-*-* 04:30:00
RandomizedDelaySec=300
# 服务器关机错过的时间点，开机后补跑一次
Persistent=true
Unit=scramble-books-backup.service

[Install]
WantedBy=timers.target
