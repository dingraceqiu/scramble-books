# Scramble Books 云端库每日自动备份（oneshot 服务，由 scramble-books-backup.timer 触发）
#
# 安装（服务器）：
#   sudo install -m 644 ops/systemd/scramble-books-backup.service /etc/systemd/system/
#   sudo install -m 644 ops/systemd/scramble-books-backup.timer   /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now scramble-books-backup.timer
#
# 手动触发一次：
#   sudo systemctl start scramble-books-backup.service
#   journalctl -u scramble-books-backup.service -n 50 --no-pager
#
# 边界：本服务与 scramble-books.service（在线 API）完全独立，只读访问
# /home/ubuntu/apps/data/cloud.db，失败不会影响在线服务；备份写入独立目录。

[Unit]
Description=Scramble Books cloud DB backup (SQLite VACUUM INTO)
# 只依赖在线服务已启动（保证 WAL/SHM 已就位），不做任何停止/重启动作
After=scramble-books.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/apps/scramble-books
ExecStart=/usr/bin/node /home/ubuntu/apps/scramble-books/scripts/cloud-backup/cloud-backup.mjs backup
Environment=CLOUD_DB_PATH=/home/ubuntu/apps/data/cloud.db
Environment=CLOUD_BACKUP_DIR=/home/ubuntu/apps/data/scramble-books-backups
Environment=CLOUD_BACKUP_KEEP_DAILY=7
Environment=CLOUD_BACKUP_KEEP_WEEKLY=4

# 资源与安全边界：
# - 整个文件系统只读，仅备份目录可写（源库因此天然不可写）；
# - 独立 /tmp、禁止提权；UMask=0077 保证备份目录/文件为 0700/0600；
# - 日志只进 journald。
Nice=10
MemoryMax=512M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/apps/data/scramble-books-backups
UMask=0077

[Install]
WantedBy=multi-user.target
